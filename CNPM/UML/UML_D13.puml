@startuml Sơ_đồ_lớp_MVC
class DAO {
  ~ con: Connection
  + DAO()
}
class TrangChuFrm {
  + actionPerformed(e: ActionEvent): void
}
class ThốngkêtourtheodoanhthuFrm {
  + actionPerformed(e: ActionEvent): void
}
class XacNhanThốngkêtourtheodoanhthuFrm {
  + actionPerformed(e: ActionEvent): void
}
class KhachHangDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- KhachHangDAO
class TourDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- TourDAO
class LichTrinhTourDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- LichTrinhTourDAO
class BookingDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- BookingDAO
class NhanVien {
  - id: int
}
class KhachHang {
  - id: int
}
class Tour {
  - id: int
}
class LichTrinhTour {
  - id: int
}
class HoaDonDatTour {
  - id: int
}
class PhieuHuyTour {
  - id: int
}
class DiaDiemDen {
  - id: int
}
TrangChuFrm ..> ThốngkêtourtheodoanhthuFrm
ThốngkêtourtheodoanhthuFrm ..> XacNhanThốngkêtourtheodoanhthuFrm
ThốngkêtourtheodoanhthuFrm --> KhachHangDAO
XacNhanThốngkêtourtheodoanhthuFrm --> TourDAO
@enduml

@startuml Sơ_đồ_tuần_tự
actor "Nhân viên" as User
boundary TrangChuFrm
boundary ThốngkêtourtheodoanhthuFrm
boundary XacNhanThốngkêtourtheodoanhthuFrm
control KhachHangDAO
control TourDAO
database CSDL
User -> TrangChuFrm : Chọn chức năng "Thống kê tour theo doanh thu"
activate TrangChuFrm
TrangChuFrm -> ThốngkêtourtheodoanhthuFrm : new ThốngkêtourtheodoanhthuFrm()
activate ThốngkêtourtheodoanhthuFrm
ThốngkêtourtheodoanhthuFrm --> User : hiển thị biểu mẫu nhập dữ liệu
deactivate TrangChuFrm
User -> ThốngkêtourtheodoanhthuFrm : Nhập khóa tra cứu và click tìm kiếm
ThốngkêtourtheodoanhthuFrm -> KhachHangDAO : timKiemTheoMa(ma)
activate KhachHangDAO
KhachHangDAO -> CSDL : SELECT chi tiết đối tượng
activate CSDL
CSDL --> KhachHangDAO : Trả kết quả về
deactivate CSDL
KhachHangDAO --> ThốngkêtourtheodoanhthuFrm : Trả về đối tượng Entity
deactivate KhachHangDAO
ThốngkêtourtheodoanhthuFrm -> XacNhanThốngkêtourtheodoanhthuFrm : new XacNhanThốngkêtourtheodoanhthuFrm(Entity)
activate XacNhanThốngkêtourtheodoanhthuFrm
XacNhanThốngkêtourtheodoanhthuFrm --> User : hiển thị chi tiết màn hình nghiệp vụ chính
deactivate ThốngkêtourtheodoanhthuFrm
User -> XacNhanThốngkêtourtheodoanhthuFrm : Bấm nút Xác nhận lưu giao dịch
XacNhanThốngkêtourtheodoanhthuFrm -> TourDAO : themGiaoDich(data)
activate TourDAO
TourDAO -> CSDL : INSERT/UPDATE dữ liệu mới
activate CSDL
CSDL --> TourDAO : Lưu thành công
deactivate CSDL
TourDAO --> XacNhanThốngkêtourtheodoanhthuFrm : Trả về Success = true
deactivate TourDAO
XacNhanThốngkêtourtheodoanhthuFrm --> User : Thông báo thành công
deactivate XacNhanThốngkêtourtheodoanhthuFrm
@enduml
