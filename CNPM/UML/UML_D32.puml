@startuml Sơ_đồ_lớp_thực_thể
class NhanVien {
  - id: int
  - hoTen: String
  - password: String
  - chucVu: String
}
class KhachHang {
  - id: int
  - maKhach: String
  - hoTen: String
  - dienThoai: String
  - diaChi: String
}
class MatHang {
  - id: int
  - maHang: String
  - tenHang: String
  - giaBan: double
  - soLuong: int
}
class GiaoDich {
  - id: int
  - khachHangId: int
  - nhanVienId: int
  - ngayLap: Date
  - tongTien: double
}
class ChiTietGiaoDich {
  - id: int
  - giaoDichId: int
  - matHangId: int
  - soLuong: int
  - donGia: double
}
KhachHang "1" -- "0..*" GiaoDich
NhanVien "1" -- "0..*" GiaoDich
GiaoDich "1" *-- "0..*" ChiTietGiaoDich
ChiTietGiaoDich "0..*" -- "1" MatHang
@enduml

@startuml Sơ_đồ_lớp_MVC
class DAO {
  ~ con: Connection
  + DAO()
}
class TrangChuFrm {
  + actionPerformed(e: ActionEvent): void
}
class XemBXHcáctayđuaFrm {
  + actionPerformed(e: ActionEvent): void
}
class XacNhanXemBXHcáctayđuaFrm {
  + actionPerformed(e: ActionEvent): void
}
class KhachHangDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- KhachHangDAO
class MatHangDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- MatHangDAO
class GiaoDichDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- GiaoDichDAO
class ChiTietGiaoDichDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- ChiTietGiaoDichDAO
class NhanVien {
  - id: int
}
class KhachHang {
  - id: int
}
class MatHang {
  - id: int
}
class GiaoDich {
  - id: int
}
class ChiTietGiaoDich {
  - id: int
}
TrangChuFrm ..> XemBXHcáctayđuaFrm
XemBXHcáctayđuaFrm ..> XacNhanXemBXHcáctayđuaFrm
XemBXHcáctayđuaFrm --> KhachHangDAO
XacNhanXemBXHcáctayđuaFrm --> MatHangDAO
@enduml

@startuml Sơ_đồ_tuần_tự
actor "Nhân viên" as User
boundary TrangChuFrm
boundary XemBXHcáctayđuaFrm
boundary XacNhanXemBXHcáctayđuaFrm
control KhachHangDAO
control MatHangDAO
database CSDL
User -> TrangChuFrm : Chọn chức năng "Xem BXH các tay đua"
activate TrangChuFrm
TrangChuFrm -> XemBXHcáctayđuaFrm : new XemBXHcáctayđuaFrm()
activate XemBXHcáctayđuaFrm
XemBXHcáctayđuaFrm --> User : hiển thị biểu mẫu nhập dữ liệu
deactivate TrangChuFrm
User -> XemBXHcáctayđuaFrm : Nhập khóa tra cứu và click tìm kiếm
XemBXHcáctayđuaFrm -> KhachHangDAO : timKiemTheoMa(ma)
activate KhachHangDAO
KhachHangDAO -> CSDL : SELECT chi tiết đối tượng
activate CSDL
CSDL --> KhachHangDAO : Trả kết quả về
deactivate CSDL
KhachHangDAO --> XemBXHcáctayđuaFrm : Trả về đối tượng Entity
deactivate KhachHangDAO
XemBXHcáctayđuaFrm -> XacNhanXemBXHcáctayđuaFrm : new XacNhanXemBXHcáctayđuaFrm(Entity)
activate XacNhanXemBXHcáctayđuaFrm
XacNhanXemBXHcáctayđuaFrm --> User : hiển thị chi tiết màn hình nghiệp vụ chính
deactivate XemBXHcáctayđuaFrm
User -> XacNhanXemBXHcáctayđuaFrm : Bấm nút Xác nhận lưu giao dịch
XacNhanXemBXHcáctayđuaFrm -> MatHangDAO : themGiaoDich(data)
activate MatHangDAO
MatHangDAO -> CSDL : INSERT/UPDATE dữ liệu mới
activate CSDL
CSDL --> MatHangDAO : Lưu thành công
deactivate CSDL
MatHangDAO --> XacNhanXemBXHcáctayđuaFrm : Trả về Success = true
deactivate MatHangDAO
XacNhanXemBXHcáctayđuaFrm --> User : Thông báo thành công
deactivate XacNhanXemBXHcáctayđuaFrm
@enduml
