LichTrinhTour "1" -- "0..*" HoaDonDatTour
Tour "1" *-- "0..*" LichTrinhTour
HoaDonDatTour "1" -- "0..1" PhieuHuyTour
Tour "1" -- "0..*" DiaDiemDen
@enduml

@startuml Sơ_đồ_lớp_MVC
class DAO {
  ~ con: Connection
  + DAO()
}
class TrangChuFrm {
  + actionPerformed(e: ActionEvent): void
}
class MuavéFrm {
  + actionPerformed(e: ActionEvent): void
}
class XacNhanMuavéFrm {
  + actionPerformed(e: ActionEvent): void
}
class KhachHangDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- KhachHangDAO
class TourDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- TourDAO
class LichTrinhTourDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- LichTrinhTourDAO
class BookingDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- BookingDAO
class NhanVien {
  - id: int
}
class KhachHang {
  - id: int
}
class Tour {
  - id: int
}
class LichTrinhTour {
  - id: int
}
class HoaDonDatTour {
  - id: int
}
class PhieuHuyTour {
  - id: int
}
class DiaDiemDen {
  - id: int
}
TrangChuFrm ..> MuavéFrm
MuavéFrm ..> XacNhanMuavéFrm
MuavéFrm --> KhachHangDAO
XacNhanMuavéFrm --> TourDAO
@enduml

@startuml Sơ_đồ_tuần_tự
actor "Nhân viên" as User
boundary TrangChuFrm
boundary MuavéFrm
boundary XacNhanMuavéFrm
control KhachHangDAO
control TourDAO
database CSDL
User -> TrangChuFrm : Chọn chức năng "Mua vé"
activate TrangChuFrm
TrangChuFrm -> MuavéFrm : new MuavéFrm()
activate MuavéFrm
MuavéFrm --> User : hiển thị biểu mẫu nhập dữ liệu
deactivate TrangChuFrm
User -> MuavéFrm : Nhập khóa tra cứu và click tìm kiếm
MuavéFrm -> KhachHangDAO : timKiemTheoMa(ma)
activate KhachHangDAO
KhachHangDAO -> CSDL : SELECT chi tiết đối tượng
activate CSDL
CSDL --> KhachHangDAO : Trả kết quả về
deactivate CSDL
KhachHangDAO --> MuavéFrm : Trả về đối tượng Entity
deactivate KhachHangDAO
MuavéFrm -> XacNhanMuavéFrm : new XacNhanMuavéFrm(Entity)
activate XacNhanMuavéFrm
XacNhanMuavéFrm --> User : hiển thị chi tiết màn hình nghiệp vụ chính
deactivate MuavéFrm
User -> XacNhanMuavéFrm : Bấm nút Xác nhận lưu giao dịch
XacNhanMuavéFrm -> TourDAO : themGiaoDich(data)
activate TourDAO
TourDAO -> CSDL : INSERT/UPDATE dữ liệu mới
activate CSDL
CSDL --> TourDAO : Lưu thành công
deactivate CSDL
TourDAO --> XacNhanMuavéFrm : Trả về Success = true
deactivate TourDAO
XacNhanMuavéFrm --> User : Thông báo thành công
deactivate XacNhanMuavéFrm
@enduml
