KhachHang "1" -- "0..*" GiaoDich
NhanVien "1" -- "0..*" GiaoDich
GiaoDich "1" *-- "0..*" ChiTietGiaoDich
ChiTietGiaoDich "0..*" -- "1" MatHang
@enduml

@startuml Sơ_đồ_lớp_MVC
class DAO {
  ~ con: Connection
  + DAO()
}
class TrangChuFrm {
  + actionPerformed(e: ActionEvent): void
}
class ThanhtoánchođốitácFrm {
  + actionPerformed(e: ActionEvent): void
}
class XacNhanThanhtoánchođốitácFrm {
  + actionPerformed(e: ActionEvent): void
}
class KhachHangDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- KhachHangDAO
class MatHangDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- MatHangDAO
class GiaoDichDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- GiaoDichDAO
class ChiTietGiaoDichDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- ChiTietGiaoDichDAO
class NhanVien {
  - id: int
}
class KhachHang {
  - id: int
}
class MatHang {
  - id: int
}
class GiaoDich {
  - id: int
}
class ChiTietGiaoDich {
  - id: int
}
TrangChuFrm ..> ThanhtoánchođốitácFrm
ThanhtoánchođốitácFrm ..> XacNhanThanhtoánchođốitácFrm
ThanhtoánchođốitácFrm --> KhachHangDAO
XacNhanThanhtoánchođốitácFrm --> MatHangDAO
@enduml

@startuml Sơ_đồ_tuần_tự
actor "Nhân viên" as User
boundary TrangChuFrm
boundary ThanhtoánchođốitácFrm
boundary XacNhanThanhtoánchođốitácFrm
control KhachHangDAO
control MatHangDAO
database CSDL
User -> TrangChuFrm : Chọn chức năng "“Thanh toán cho đối tác”"
activate TrangChuFrm
TrangChuFrm -> ThanhtoánchođốitácFrm : new ThanhtoánchođốitácFrm()
activate ThanhtoánchođốitácFrm
ThanhtoánchođốitácFrm --> User : hiển thị biểu mẫu nhập dữ liệu
deactivate TrangChuFrm
User -> ThanhtoánchođốitácFrm : Nhập khóa tra cứu và click tìm kiếm
ThanhtoánchođốitácFrm -> KhachHangDAO : timKiemTheoMa(ma)
activate KhachHangDAO
KhachHangDAO -> CSDL : SELECT chi tiết đối tượng
activate CSDL
CSDL --> KhachHangDAO : Trả kết quả về
deactivate CSDL
KhachHangDAO --> ThanhtoánchođốitácFrm : Trả về đối tượng Entity
deactivate KhachHangDAO
ThanhtoánchođốitácFrm -> XacNhanThanhtoánchođốitácFrm : new XacNhanThanhtoánchođốitácFrm(Entity)
activate XacNhanThanhtoánchođốitácFrm
XacNhanThanhtoánchođốitácFrm --> User : hiển thị chi tiết màn hình nghiệp vụ chính
deactivate ThanhtoánchođốitácFrm
User -> XacNhanThanhtoánchođốitácFrm : Bấm nút Xác nhận lưu giao dịch
XacNhanThanhtoánchođốitácFrm -> MatHangDAO : themGiaoDich(data)
activate MatHangDAO
MatHangDAO -> CSDL : INSERT/UPDATE dữ liệu mới
activate CSDL
CSDL --> MatHangDAO : Lưu thành công
deactivate CSDL
MatHangDAO --> XacNhanThanhtoánchođốitácFrm : Trả về Success = true
deactivate MatHangDAO
XacNhanThanhtoánchođốitácFrm --> User : Thông báo thành công
deactivate XacNhanThanhtoánchođốitácFrm
@enduml
