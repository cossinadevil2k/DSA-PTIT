@startuml Sơ_đồ_lớp_thực_thể
class NhanVien {
  - id: int
  - hoTen: String
  - password: String
  - chucVu: String
}
class KhachHang {
  - id: int
  - maKhach: String
  - hoTen: String
  - dienThoai: String
  - diaChi: String
}
class MatHang {
  - id: int
  - maHang: String
  - tenHang: String
  - giaBan: double
  - soLuong: int
}
class GiaoDich {
  - id: int
  - khachHangId: int
  - nhanVienId: int
  - ngayLap: Date
  - tongTien: double
}
class ChiTietGiaoDich {
  - id: int
  - giaoDichId: int
  - matHangId: int
  - soLuong: int
  - donGia: double
}
KhachHang "1" -- "0..*" GiaoDich
NhanVien "1" -- "0..*" GiaoDich
GiaoDich "1" *-- "0..*" ChiTietGiaoDich
ChiTietGiaoDich "0..*" -- "1" MatHang
@enduml

@startuml Sơ_đồ_lớp_MVC
class DAO {
  ~ con: Connection
  + DAO()
}
class TrangChuFrm {
  + actionPerformed(e: ActionEvent): void
}
class Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm {
  + actionPerformed(e: ActionEvent): void
}
class XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm {
  + actionPerformed(e: ActionEvent): void
}
class KhachHangDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- KhachHangDAO
class MatHangDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- MatHangDAO
class GiaoDichDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- GiaoDichDAO
class ChiTietGiaoDichDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- ChiTietGiaoDichDAO
class NhanVien {
  - id: int
}
class KhachHang {
  - id: int
}
class MatHang {
  - id: int
}
class GiaoDich {
  - id: int
}
class ChiTietGiaoDich {
  - id: int
}
TrangChuFrm ..> Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm
Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm ..> XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm
Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm --> KhachHangDAO
XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm --> MatHangDAO
@enduml

@startuml Sơ_đồ_tuần_tự
actor "Nhân viên" as User
boundary TrangChuFrm
boundary Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm
boundary XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm
control KhachHangDAO
control MatHangDAO
database CSDL
User -> TrangChuFrm : Chọn chức năng "“Lên lịch chiếu”  cho phép quản lí (QL) thực hiện lên lịch chiếu cho phim (phòng chiếu)"
activate TrangChuFrm
TrangChuFrm -> Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm : new Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm()
activate Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm
Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm --> User : hiển thị biểu mẫu nhập dữ liệu
deactivate TrangChuFrm
User -> Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm : Nhập khóa tra cứu và click tìm kiếm
Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm -> KhachHangDAO : timKiemTheoMa(ma)
activate KhachHangDAO
KhachHangDAO -> CSDL : SELECT chi tiết đối tượng
activate CSDL
CSDL --> KhachHangDAO : Trả kết quả về
deactivate CSDL
KhachHangDAO --> Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm : Trả về đối tượng Entity
deactivate KhachHangDAO
Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm -> XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm : new XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm(Entity)
activate XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm
XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm --> User : hiển thị chi tiết màn hình nghiệp vụ chính
deactivate Lênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm
User -> XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm : Bấm nút Xác nhận lưu giao dịch
XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm -> MatHangDAO : themGiaoDich(data)
activate MatHangDAO
MatHangDAO -> CSDL : INSERT/UPDATE dữ liệu mới
activate CSDL
CSDL --> MatHangDAO : Lưu thành công
deactivate CSDL
MatHangDAO --> XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm : Trả về Success = true
deactivate MatHangDAO
XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm --> User : Thông báo thành công
deactivate XacNhanLênlịchchiếuchophépquảnlí(QL)thựchiệnlênlịchchiếuchophim(phòngchiếu)Frm
@enduml
