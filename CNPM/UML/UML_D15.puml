@startuml Sơ_đồ_lớp_MVC
class DAO {
  ~ con: Connection
  + DAO()
}
class TrangChuFrm {
  + actionPerformed(e: ActionEvent): void
}
class GọimónFrm {
  + actionPerformed(e: ActionEvent): void
}
class XacNhanGọimónFrm {
  + actionPerformed(e: ActionEvent): void
}
class TableDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- TableDAO
class FoodItemDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- FoodItemDAO
class OrderDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- OrderDAO
class BillDAO {
  + layDuLieu(): Object
  + luuDuLieu(): boolean
}
DAO <|-- BillDAO
class NhanVien {
  - id: int
}
class BanAn {
  - id: int
}
class KhachHang {
  - id: int
}
class MonAn {
  - id: int
}
class ComboMon {
  - id: int
}
class ComboChiTiet {
  - id: int
}
class PhieuGoiMon {
  - id: int
}
class ChiTietGoiMon {
  - id: int
}
class HoaDonThanhToan {
  - id: int
}
class PhieuGiamGia {
  - id: int
}
TrangChuFrm ..> GọimónFrm
GọimónFrm ..> XacNhanGọimónFrm
GọimónFrm --> TableDAO
XacNhanGọimónFrm --> FoodItemDAO
@enduml

@startuml Sơ_đồ_tuần_tự
actor "Nhân viên phục vụ" as User
boundary TrangChuFrm
boundary GọimónFrm
boundary XacNhanGọimónFrm
control TableDAO
control FoodItemDAO
database CSDL
User -> TrangChuFrm : Chọn chức năng "Gọi món"
activate TrangChuFrm
TrangChuFrm -> GọimónFrm : new GọimónFrm()
activate GọimónFrm
GọimónFrm --> User : hiển thị biểu mẫu nhập dữ liệu
deactivate TrangChuFrm
User -> GọimónFrm : Nhập khóa tra cứu và click tìm kiếm
GọimónFrm -> TableDAO : timKiemTheoMa(ma)
activate TableDAO
TableDAO -> CSDL : SELECT chi tiết đối tượng
activate CSDL
CSDL --> TableDAO : Trả kết quả về
deactivate CSDL
TableDAO --> GọimónFrm : Trả về đối tượng Entity
deactivate TableDAO
GọimónFrm -> XacNhanGọimónFrm : new XacNhanGọimónFrm(Entity)
activate XacNhanGọimónFrm
XacNhanGọimónFrm --> User : hiển thị chi tiết màn hình nghiệp vụ chính
deactivate GọimónFrm
User -> XacNhanGọimónFrm : Bấm nút Xác nhận lưu giao dịch
XacNhanGọimónFrm -> FoodItemDAO : themGiaoDich(data)
activate FoodItemDAO
FoodItemDAO -> CSDL : INSERT/UPDATE dữ liệu mới
activate CSDL
CSDL --> FoodItemDAO : Lưu thành công
deactivate CSDL
FoodItemDAO --> XacNhanGọimónFrm : Trả về Success = true
deactivate FoodItemDAO
XacNhanGọimónFrm --> User : Thông báo thành công
deactivate XacNhanGọimónFrm
@enduml
